// GLSL shaders
vertex_program GaussianNoiseVS_GLSL glsl
{
  source gaussian_noise_vs.glsl
}

fragment_program GaussianNoiseFS_GLSL glsl
{
  source gaussian_noise_fs.glsl
  default_params
  {
    param_named RT int 0
    param_named Blur1 int 1
    param_named depthTexture int 2
  }
}

// vULKAN shaders
vertex_program GaussianNoiseVS_VK glslvk
{
  source gaussian_noise_vs.glsl
}

fragment_program GaussianNoiseFS_VK glslvk
{
  source gaussian_noise_fs.glsl
}

// Metal shaders
vertex_program GaussianNoiseVS_Metal metal
{
  source gaussian_noise_vs.metal
}

fragment_program GaussianNoiseFS_Metal metal
{
  source gaussian_noise_fs.metal
  shader_reflection_pair_hint GaussianNoiseVS_Metal
}

// Unified shaders
vertex_program GaussianNoiseVS unified
{
  delegate GaussianNoiseVS_GLSL
  delegate GaussianNoiseVS_Metal
  delegate GaussianNoiseVS_VK

  default_params
  {
    param_named_auto worldViewProj worldviewproj_matrix
  }
}

fragment_program GaussianNoiseFS unified
{
  delegate GaussianNoiseFS_GLSL
  delegate GaussianNoiseFS_Metal
  delegate GaussianNoiseFS_VK

  default_params
  {
    // param_named mean float 0.0
    // param_named stddev float 1.0
    param_named waterDensity float 0.05
    param_named waterColor float3 0.0 0.0 0.0
  }
}

material GaussianNoise
{
  technique
  {
    pass
    {
      // depth_check off
      // depth_write off
      // cull_hardware none

      vertex_program_ref GaussianNoiseVS { }
      fragment_program_ref GaussianNoiseFS { }

      texture_unit RT
      {
        tex_coord_set 0
        tex_address_mode clamp
        filtering linear linear linear
      }
      texture_unit depthTexture
      {
        tex_coord_set 0
        tex_address_mode clamp
        filtering linear linear linear
        // filtering bilinear
      }
      texture_unit Blur1
      {
        tex_coord_set 0
        tex_address_mode clamp
        // filtering linear linear linear
        filtering bilinear
      }
    }
  }
}

// GLSL shaders
fragment_program GaussianNoiseDepthFS_GLSL glsl
{
  source gaussian_noise_depth_fs.glsl
  default_params
  {
    param_named RT int 0
  }
}

// Vulkan shaders
fragment_program GaussianNoiseDepthFS_VK glslvk
{
  source gaussian_noise_depth_fs.glsl
}

// Metal shaders
fragment_program GaussianNoiseDepthFS_Metal metal
{
  source gaussian_noise_depth_fs.metal
  shader_reflection_pair_hint GaussianNoiseVS_Metal
}

// Unified shaders
fragment_program GaussianNoiseDepthFS unified
{
  delegate GaussianNoiseDepthFS_GLSL
  delegate GaussianNoiseDepthFS_Metal
  delegate GaussianNoiseDepthFS_VK

  default_params
  {
    param_named mean float 0.0
    param_named stddev float 1.0
    param_named offsets float3 0.0 0.0 0.0
  }
}

material GaussianNoiseDepth
{
  technique
  {
    pass
    {
      depth_check off
      depth_write off
      cull_hardware none

      vertex_program_ref GaussianNoiseVS { }
      fragment_program_ref GaussianNoiseDepthFS { }

      texture_unit RT
      {
        tex_coord_set 0
        tex_address_mode clamp
        filtering none
      }
    }
  }
}

// https://github.com/OGRECave/ogre-next/blob/master/Samples/Media/2.0/scripts/materials/Common/Quad.program

vertex_program Quad_vs_GLSL glsl
{
	source Quad_vs.glsl
}

fragment_program BlurV_ps_GLSL glsl
{
	source BlurV_ps.glsl
  default_params
  {
    param_named RT int 0
  }
}
fragment_program BlurH_ps_GLSL glsl
{
	source BlurH_ps.glsl
  default_params
  {
    param_named RT int 0
  }
}

// vULKAN shaders
vertex_program Quad_vs_VK glsl
{
	source Quad_vs.glsl
}

fragment_program BlurV_ps_VK glsl
{
	source BlurV_ps.glsl
}
fragment_program BlurH_ps_VK glsl
{
	source BlurH_ps.glsl
}

// Unified shaders
vertex_program QuadVS unified
{
  delegate Quad_vs_GLSL
  delegate Quad_vs_VK

  default_params
  {
    param_named_auto worldViewProj worldviewproj_matrix
  }
}

fragment_program BlurHFS unified
{
  delegate BlurH_ps_GLSL
  delegate BlurH_ps_VK

}

fragment_program BlurVFS unified
{
  delegate BlurV_ps_GLSL
  delegate BlurV_ps_VK

}

//Blur: Horizontal Gaussian pass
material BlurH
{
	technique
	{
		pass
		{
			depth_check off
			depth_write off

			cull_hardware none

			vertex_program_ref QuadVS
			{
			}

			fragment_program_ref BlurHFS
			{
			}

			texture_unit RT
			{
				tex_coord_set 0
        tex_address_mode clamp
				filtering bilinear
			}
		}
	}
}

//Blur: Vertical Gaussian pass
material BlurV : BlurH
{
	technique
	{
		pass
		{
			fragment_program_ref BlurVFS
			{
			}
		}
	}
}

